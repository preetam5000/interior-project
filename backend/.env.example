MONGO_URL="mongodb://localhost:27017"
DB_NAME="interior_social"
# Optional generative final polish. Configure Cloudinary storage in the app's Settings.
EMERGENT_LLM_KEY=
OPENAI_API_KEY=
USE_AI_EDITOR=false
# Optional estimated price per GPT Image edit in USD; leave blank when unknown.
OPENAI_IMAGE_COST_USD=
# Optional local CLIPSeg masks; without masks, guarded stages use full-frame fallback.
SCENE_SEGMENTATION_ENABLED=false
SCENE_SEGMENTATION_MODEL=CIDAS/clipseg-rd64-refined
SCENE_SEGMENTATION_THRESHOLD=0.5
# Optional local OpenCV DNN Super Resolution model (FSRCNN_x2.pb, EDSR_x2.pb, or ESPCN_x2.pb).
# Place the model in backend/models or set an absolute container path. Weights are never downloaded automatically.
OPENCV_SUPERRES_MODEL=
OPENCV_SUPERRES_ALGORITHM=fsrcnn
OPENCV_SUPERRES_MAX_OUTPUT_PIXELS=50000000
EDITOR_MODE=architectural
# Optional image used only as a photographic-style reference, not as scene content.
# Use an absolute path to a mounted, supported image file; leave blank to disable.
EDITOR_STYLE_REFERENCE=
JWT_SECRET="replace-with-a-random-secret-before-running"
ADMIN_EMAIL="admin@yourstudio.com"
ADMIN_PASSWORD="replace-before-running"
PUBLIC_BASE_URL="https://your-backend-domain"
FRONTEND_URL="https://your-frontend-domain"
# Google Drive OAuth and folder picker. Register the callback URL exactly as:
# https://your-backend-domain/api/settings/google-drive/oauth-callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable and private; changing it makes already stored refresh tokens unreadable.
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
# Numeric Google Cloud Project Number for Google Picker (not the Project ID).
GOOGLE_CLOUD_PROJECT_NUMBER=
# Poll interval in seconds (minimum 5; defaults to 30).
GOOGLE_DRIVE_SYNC_INTERVAL_SECONDS=30
